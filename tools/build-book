#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BOOK="${1:-${BOOK:-}}"
[[ -n "$BOOK" ]] || { echo "usage: build-book BOOK|BOOK=name" >&2; exit 2; }
SRC="$ROOT/books/$BOOK/manuscript/index.org"
OUT="$ROOT/books/$BOOK/dist/$BOOK.epub"
[[ -f "$SRC" ]] || { echo "unknown book: $BOOK" >&2; exit 2; }
mkdir -p "$(dirname "$OUT")"
PREPARED="$(mktemp "$ROOT/books/$BOOK/manuscript/.index-pandoc.XXXXXX.org")"
trap 'rm -f "$PREPARED"' EXIT
python3 "$ROOT/tools/prepare-org-for-pandoc" "$SRC" "$PREPARED"
pandoc "$PREPARED" \
  --from=org \
  --to=epub3 \
  --standalone \
  --resource-path="$ROOT/books/$BOOK:$ROOT" \
  --css="$ROOT/assets/styles/epub.css" \
  --metadata-file="$ROOT/books/$BOOK/metadata.yaml" \
  --lua-filter="$ROOT/tools/pandoc-org-id.lua" \
  -o "$OUT"
echo "$OUT"
