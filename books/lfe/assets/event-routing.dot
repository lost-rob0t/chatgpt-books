digraph EventRouting {
  rankdir=LR;
  graph [bgcolor="transparent", pad="0.2", nodesep="0.5", ranksep="0.7"];
  node [shape=box, style="rounded", fontname="sans-serif"];
  edge [fontname="sans-serif"];

  event [label="event term\n#(event level service payload)"];
  rules [label="ordered rule list\nwhen-level / when-service / otherwise"];
  match [shape=diamond, label="first matching\nrule?"];
  ok [label="#(ok destination)"];
  exhausted [shape=diamond, label="list exhausted?"];
  err [label="#(error no-route)\nor tagged bad input"];

  event -> rules [label="route/2"];
  rules -> match [label="inspect head"];
  match -> ok [label="yes"];
  match -> exhausted [label="no"];
  exhausted -> rules [label="no: recurse on tail"];
  exhausted -> err [label="yes"];
}
