#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PROJECT="$ROOT/books/lfe/code/otp-router"
EVENT_RULES="$ROOT/books/lfe/code/event-rules/src/event-rules.lfe"
BUILD="$(mktemp -d)"
trap 'rm -rf "$BUILD"' EXIT

APP_EBIN="$BUILD/lib/otp_router-0.1.0/ebin"
TEST_EBIN="$BUILD/test-ebin"
REL_DIR="$BUILD/release"
mkdir -p "$APP_EBIN" "$TEST_EBIN" "$REL_DIR"

command -v lfec >/dev/null || { echo "lfec is required" >&2; exit 2; }
command -v erlc >/dev/null || { echo "erlc is required" >&2; exit 2; }
command -v erl >/dev/null || { echo "erl is required" >&2; exit 2; }

lfec -o "$APP_EBIN" \
  "$EVENT_RULES" \
  "$PROJECT/src/otp-router.lfe" \
  "$PROJECT/src/otp-router-sup.lfe" \
  "$PROJECT/src/otp-router-app.lfe"
erlc -o "$TEST_EBIN" "$PROJECT/test/otp_router_release_tests.erl"
cp "$PROJECT/src/otp_router.app.src" "$APP_EBIN/otp_router.app"

# First prove the application resource/callback boundary independently of any
# release script. The assertions live in a compiled Erlang module instead of a
# long erl -eval expression so the test exercises normal BEAM code rather than
# erl_eval's deliberately smaller expression surface.
erl -pa "$TEST_EBIN" -pa "$APP_EBIN" -noshell -eval '
  case otp_router_release_tests:application_lifecycle() of
      ok -> halt(0);
      Other -> io:format("application lifecycle returned: ~p~n", [Other]), halt(1)
  end.'

ERTS_VSN="$(erl -noshell -eval 'io:format("~s", [erlang:system_info(version)]), halt().' )"
KERNEL_VSN="$(erl -noshell -eval '{ok,V}=application:get_key(kernel,vsn), io:format("~s",[V]), halt().' )"
STDLIB_VSN="$(erl -noshell -eval '{ok,V}=application:get_key(stdlib,vsn), io:format("~s",[V]), halt().' )"
REL_BASE="$REL_DIR/lfe_router_release"

cat > "$REL_BASE.rel" <<REL
{release,
 {"lfe_router_release", "0.1.0"},
 {erts, "$ERTS_VSN"},
 [{kernel, "$KERNEL_VSN"},
  {stdlib, "$STDLIB_VSN"},
  {otp_router, "0.1.0"}]}.
REL

# local keeps the actual build paths in the boot script. That is exactly what
# we want for a CI proof of construction and boot, and exactly what we do NOT
# claim is a relocatable installed target system.
erl -noshell -pa "$APP_EBIN" -eval "
  case systools:make_script(\"$REL_BASE\", [{path,[\"$APP_EBIN\"]}, local, no_warn_sasl, warnings_as_errors, silent]) of
      {ok,_,[]} -> halt(0);
      {ok,Mod,Warnings} -> io:format(\"unexpected warnings ~p: ~p~n\", [Mod,Warnings]), halt(1);
      Other -> io:format(\"make_script failed: ~p~n\", [Other]), halt(1)
  end."

test -s "$REL_BASE.script"
test -s "$REL_BASE.boot"

# This is a genuinely fresh VM started from the generated boot file, not the VM
# that built the artifacts. The compiled helper verifies application identity,
# ownership of the supervision tree, and one real routed request.
erl -noshell -boot "$REL_BASE" -pa "$TEST_EBIN" -eval '
  case otp_router_release_tests:boot_state() of
      ok -> halt(0);
      Other -> io:format("release boot verification returned: ~p~n", [Other]), halt(1)
  end.'

# Failure lab 1: .rel and .app versions are one contract. Assert the structured
# no_valid_version reason used by both the OTP-25 runner lineage and current
# OTP 29.1 instead of allowing an unrelated release-construction error to pass.
BAD_VERSION_BASE="$REL_DIR/bad_version_release"
sed 's/{otp_router, "0.1.0"}/{otp_router, "9.9.9"}/' \
  "$REL_BASE.rel" > "$BAD_VERSION_BASE.rel"
erl -noshell -pa "$APP_EBIN" -eval "
  case systools:make_script(\"$BAD_VERSION_BASE\", [{path,[\"$APP_EBIN\"]}, local, no_warn_sasl, silent]) of
      {error,systools_make,Errors} when is_list(Errors) ->
          case lists:any(
                 fun({error_reading,{otp_router,{no_valid_version,_}}}) -> true;
                    (_) -> false
                 end,
                 Errors) of
              true -> halt(0);
              false -> io:format(\"expected otp_router no_valid_version, got: ~p~n\", [Errors]), halt(1)
          end;
      Other -> io:format(\"expected version mismatch failure, got: ~p~n\", [Other]), halt(1)
  end."

# Failure lab 2: application dependencies declared by .app must be represented
# in the release closure. Inject crypto into a disposable app resource while
# deliberately omitting it from .rel. Assert that crypto is specifically named
# by the structured undefined_applications reason.
MISSING_EBIN="$BUILD/missing-dependency/ebin"
mkdir -p "$MISSING_EBIN"
cp "$APP_EBIN"/*.beam "$MISSING_EBIN/"
sed 's/{applications, \[kernel, stdlib\]}/{applications, [kernel, stdlib, crypto]}/' \
  "$APP_EBIN/otp_router.app" > "$MISSING_EBIN/otp_router.app"
MISSING_BASE="$REL_DIR/missing_dependency_release"
cp "$REL_BASE.rel" "$MISSING_BASE.rel"
erl -noshell -pa "$MISSING_EBIN" -eval "
  case systools:make_script(\"$MISSING_BASE\", [{path,[\"$MISSING_EBIN\"]}, local, no_warn_sasl, silent]) of
      {error,systools_make,{undefined_applications,Apps}} ->
          case lists:member(crypto, Apps) of
              true -> halt(0);
              false -> io:format(\"expected crypto in undefined applications, got: ~p~n\", [Apps]), halt(1)
          end;
      Other -> io:format(\"expected missing dependency failure, got: ~p~n\", [Other]), halt(1)
  end."

# Rebuild without local paths and create a release package. Inspect its shape,
# but do not pretend this proves deployment on a different host or bundled ERTS.
erl -noshell -pa "$APP_EBIN" -eval "
  case systools:make_script(\"$REL_BASE\", [{path,[\"$APP_EBIN\"]}, no_warn_sasl, warnings_as_errors, silent]) of
      {ok,_,[]} -> ok;
      {ok,Mod,Warnings} -> io:format(\"unexpected packaging warnings ~p: ~p~n\", [Mod,Warnings]), halt(1);
      Other1 -> io:format(\"relocatable make_script failed: ~p~n\", [Other1]), halt(1)
  end,
  case systools:make_tar(\"$REL_BASE\", [{path,[\"$APP_EBIN\"]}, no_warn_sasl, warnings_as_errors, silent]) of
      {ok,_,[]} -> halt(0);
      {ok,Mod2,Warnings2} -> io:format(\"unexpected tar warnings ~p: ~p~n\", [Mod2,Warnings2]), halt(1);
      Other2 -> io:format(\"make_tar failed: ~p~n\", [Other2]), halt(1)
  end."

PACKAGE="$REL_BASE.tar.gz"
test -s "$PACKAGE"
tar -tzf "$PACKAGE" > "$BUILD/package-contents.txt"
grep -q '^lib/otp_router-0.1.0/ebin/otp_router.app$' "$BUILD/package-contents.txt"
grep -q '^lib/otp_router-0.1.0/ebin/event-rules.beam$' "$BUILD/package-contents.txt"
grep -q '^lib/otp_router-0.1.0/ebin/otp-router-app.beam$' "$BUILD/package-contents.txt"
grep -q '^releases/0.1.0/start.boot$' "$BUILD/package-contents.txt"
grep -q '^releases/0.1.0/lfe_router_release.rel$' "$BUILD/package-contents.txt"
grep -q '^releases/lfe_router_release.rel$' "$BUILD/package-contents.txt"

printf 'otp-router-release: PASS (ERTS %s, kernel %s, stdlib %s)\n' \
  "$ERTS_VSN" "$KERNEL_VSN" "$STDLIB_VSN"
