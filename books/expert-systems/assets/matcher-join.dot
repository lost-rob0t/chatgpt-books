digraph matcher_join {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];

  facts [label="Fact set\n(stable IDs + provenance)"];
  c1 [label="C1: service-state\n?service failed"];
  c2 [label="C2: service-restart-policy\n?service on-failure"];
  c3 [label="C3: depends-on\n?dependent ?service"];
  b1 [label="Partial binding\n?service = api"];
  b2 [label="Joined binding\n?service = api\n?dependent = frontend"];
  support [label="Support IDs\nobs.api.state.failed\ncfg.api.restart.on-failure\ndep.frontend.api"];

  facts -> c1 [label="scan"];
  facts -> c2 [label="scan"];
  c1 -> b1 [label="bind"];
  c2 -> b1 [label="agree"];
  facts -> c3 [label="scan"];
  b1 -> c3 [label="carry binding"];
  c3 -> b2 [label="extend"];
  b2 -> support [label="retain evidence"];
}
