#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
SERVER="${1:?usage: run-tests PINNED-SERVER PINNED-SDK}"
SDK="${2:?usage: run-tests PINNED-SERVER PINNED-SDK}"
export STAR_SEARCH_LAB_SERVER="$(cd "$SERVER" && pwd)"
export PYTHONPATH="$(cd "$SDK" && pwd)${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
python3 - "$HERE" "$STAR_SEARCH_LAB_SERVER" "$SDK" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from lab import require_pin, SERVER_PIN, SDK_PIN
require_pin(Path(sys.argv[2]), SERVER_PIN)
require_pin(Path(sys.argv[3]), SDK_PIN)
PY
STAR_SEARCH_STATS_DESIGN="$STAR_SEARCH_LAB_SERVER/source/views/data.json" node --test "$HERE/test_public_stats_scope_difference.js"
node --test "$HERE/test_geo_index_coverage.js"
node --test "$HERE/test_schema_version_index.js"
node --test "$HERE/test_canonical_text_coverage.js"
node --test "$HERE/test_projection_delta.js"
node --test "$HERE/test_field_footprint.js"
node --test "$HERE/test_canonical_org_type_coverage.js"
node --test "$HERE/test_investigation_operation_fts.js"
node --test "$HERE/test_event_observation_time_fts.js"
node --test "$HERE/test_alert_lifecycle_fts.js"
node --test "$HERE/test_taxonomy_metadata_fts.js"
node --test "$HERE/test_http_transaction_fts.js"
node --test "$HERE/test_canonical_tombstone_fts.js"
node --test "$HERE/test_index_input_shape.js"
node --test "$HERE/test_relation_fts_boundary.js"
node --test "$HERE/test_visibility_index_boundary.js"
node --test "$HERE/test_confidence_not_retrieval_score.js"
node --test "$HERE/test_route_generation.js"
python3 -m unittest discover -s "$HERE" -p 'test_*.py' -v
EXTRACTED="$(mktemp)"
trap 'rm -f "$EXTRACTED"' EXIT
python3 "$HERE/extract_forms.py" "$STAR_SEARCH_LAB_SERVER" "$EXTRACTED"
sbcl --script "$HERE/hermetic.lisp" "$EXTRACTED"
