;;; Dependency doubles for extracted real upstream functions.
;;; No HTTP listener, credential store, audit sink, CouchDB or Lucene is used.
(defpackage :jsown (:use :cl) (:export :new-js :val :val-safe :keyp :remkey :parse :to-json))
(in-package :jsown)
(defmacro new-js (&rest pairs)
  `(list :obj ,@(mapcar (lambda (pair) `(cons ,(first pair) ,(second pair))) pairs)))
(defun val (object key) (cdr (assoc key (cdr object) :test #'equal)))
(defun (setf val) (value object key)
  (let ((pair (assoc key (cdr object) :test #'equal)))
    (if pair (setf (cdr pair) value) (push (cons key value) (cdr object)))) value)
(defun val-safe (object key) (val object key))
(defun keyp (object key) (assoc key (cdr object) :test #'equal))
(defun remkey (object key) (setf (cdr object) (remove key (cdr object) :key #'car :test #'equal)) object)
(defun parse (value) (declare (ignore value)) (error "JSON parsing is outside this double"))
(defun to-json (value) value)
(defpackage :star.ids (:use :cl) (:export :ulid))
(in-package :star.ids)
(defun ulid () "hermetic-decision")
(defpackage :star (:use :cl) (:export :*couchdb-default-database*))
(in-package :star)
(defparameter *couchdb-default-database* "hermetic-db")
(defpackage :star.authorization (:use :cl)
  (:export :authorized-search-query :make-trusted-authorization-context :with-trusted-authorization-context))
(in-package :star.authorization)
(define-condition authorization-error (error) ((code :initarg :code) (decision :initarg :decision)))
(defvar *audit-count* 0)
(defun candidate-principal (principal) principal)
(defun principal-scopes (principal) principal)
(defun principal-id (principal) (declare (ignore principal)) "hermetic-principal")
(defun make-trusted-authorization-context (&key id principal-type scopes)
  (declare (ignore id principal-type)) scopes)
(defmacro with-trusted-authorization-context ((context) &body body)
  `(let ((unused ,context)) (declare (ignore unused)) ,@body))
(defun make-authorization-decision (&rest values) values)
(defun make-authorization-request (&rest values) values)
(defun emit-authorization-audit (request decision) (declare (ignore request decision)))
(defun emit-search-query-audit (&rest values) (declare (ignore values)) (incf *audit-count*))
;; Action gate double: scope compiler calls it, but runtime policy is not loaded.
(defun authorize! (action &key principal metadata)
  (declare (ignore metadata))
  (unless (capability-granted-p principal action)
    (error 'authorization-error :code "access_denied" :decision nil)))
(defpackage :cl-couch (:use :cl) (:export :fts-search))
(in-package :cl-couch)
(defvar *query* nil)
(defvar *calls* 0)
(defvar *failure* nil)
(defvar *result* (jsown:new-js ("rows" nil) ("bookmark" "opaque")))
(defun fts-search (client query database design index)
  (declare (ignore client))
  (assert (equal (list database design index) '("hermetic-db" "search" "fts")))
  (incf *calls*) (setf *query* query)
  (when *failure* (error "injected backend failure"))
  (copy-tree *result*))
(defpackage :star.frontends.http-api (:use :cl))
(in-package :star.frontends.http-api)
(defvar *public-search-datasets* '("book-public"))
(defvar +public-search-path+ "/api/v1/search")
(defvar *couchdb-pool* nil)
(defvar *principal* '("search:read" "dataset:book-private" "tenant:default"))
(defun current-policy-principal () *principal*)
(defun route-policy-metadata (&rest values) values)
(defun set-cache-control (value) (assert (equal value "no-store")))
(defmacro with-http-boundary (() &body body) `(progn ,@body))
(defmacro couchdb-handler ((client pool) &body body)
  `(let ((,client ,pool)) ,@body))
(in-package :cl-user)
(load (second sb-ext:*posix-argv*))
(in-package :star.frontends.http-api)
(defvar *checks* 0)
(defun check (label thunk)
  (funcall thunk) (incf *checks*) (format t "PASS ~a~%" label))
(defun rejects (params code &optional (function #'handle-public-search-route))
  (let ((before cl-couch::*calls*))
    (handler-case (progn (funcall function params) (error "expected rejection"))
      (http-input-error (condition)
        (assert (= 400 (http-input-error-status condition)))
        (assert (string= code (http-input-error-code condition)))))
    (assert (= before cl-couch::*calls*))))
(check "missing and empty q" (lambda ()
  (dolist (params '(nil (("q" . "")))) (rejects params "missing_query_parameter"))))
(check "public q length 512 accepted; 513 rejected" (lambda ()
  (handle-public-search-route (list (cons "q" (make-string 512 :initial-element #\a))))
  (rejects (list (cons "q" (make-string 513 :initial-element #\a))) "search_query_too_long")))
(check "public limit default 25 and upper 50" (lambda ()
  (handle-public-search-route '(("q" . "name:needle")))
  (assert (= 25 (jsown:val cl-couch::*query* "limit")))
  (handle-public-search-route '(("q" . "name:needle") ("limit" . "50")))
  (assert (= 50 (jsown:val cl-couch::*query* "limit")))))
(check "invalid and out-of-range public limits" (lambda ()
  (dolist (raw '("0" "-1" "51"))
    (rejects (list '("q" . "name:needle") (cons "limit" raw)) "query_parameter_out_of_range"))
  (dolist (raw '("x" "2x" "1.5"))
    (rejects (list '("q" . "name:needle") (cons "limit" raw)) "invalid_query_parameter"))))
(check "public scope overrides rejected before backend" (lambda ()
  (dolist (key '("dataset" "tenant"))
    (rejects (list '("q" . "name:needle") (cons key "private")) "public_scope_is_server_owned"))))
(check "public backend scope is server-owned" (lambda ()
  (let ((*principal* '("admin")))
    (handle-public-search-route '(("q" . "name:needle")))
    (assert (search "dataset:\"book-public\"" (jsown:val cl-couch::*query* "q")))
    (assert (not (search "tenant_id:" (jsown:val cl-couch::*query* "q")))))))
(check "public wildcard configuration is unscoped by dataset" (lambda ()
  (let ((*public-search-datasets* '("*")))
    (handle-public-search-route '(("q" . "name:needle")))
    (assert (string= "(name:needle)" (jsown:val cl-couch::*query* "q"))))))
(check "authenticated default tenant and actual 100-result cap" (lambda ()
  (handle-authorized-search-route '(("q" . "name:needle") ("limit" . "100")))
  (assert (search "tenant_id:\"default\"" (jsown:val cl-couch::*query* "q")))
  (assert (search "dataset:\"book-private\"" (jsown:val cl-couch::*query* "q")))
  (rejects '(("q" . "name:needle") ("limit" . "101")) "query_parameter_out_of_range" #'handle-authorized-search-route)))
(check "authenticated q does not inherit public 512 cap" (lambda ()
  (handle-authorized-search-route (list (cons "q" (make-string 513 :initial-element #\a))))))
(check "cross-dataset and cross-tenant denial" (lambda ()
  (dolist (extra '(("dataset" . "other") ("tenant" . "other")))
    (let ((before cl-couch::*calls*))
      (handler-case
          (progn (handle-authorized-search-route (list '("q" . "name:needle") extra))
                 (error "expected denial"))
        (star.authorization::authorization-error () nil))
      (assert (= before cl-couch::*calls*))))))
(check "missing capability reaches action-gate double" (lambda ()
  (let ((*principal* '("dataset:book-private" "tenant:default")))
    (handler-case
        (progn (handle-authorized-search-route '(("q" . "name:needle"))) (error "expected denial"))
      (star.authorization::authorization-error () nil)))))
(check "scope values escape Lucene metacharacters" (lambda ()
  (assert (equal "dataset:\"a\\\"\\:b\"" (star.authorization::lucene-term "dataset" "a\":b")))))
(check "bookmark and authenticated sort forwarded unchanged" (lambda ()
  (handle-authorized-search-route '(("q" . "name:needle") ("bookmark" . "opaque+/=") ("sort" . "name")))
  (assert (equal "opaque+/=" (jsown:val cl-couch::*query* "bookmark")))
  (assert (equal "name" (jsown:val cl-couch::*query* "sort")))
  (assert (eq t (jsown:val cl-couch::*query* "include_docs")))))
(check "server tenant scrubbed from fields, doc and outbox payload" (lambda ()
  (let* ((payload (jsown:new-js ("tenant_id" "secret") ("name" "keep")))
         (cl-couch::*result*
           (jsown:new-js ("rows" (list (jsown:new-js
             ("id" "synthetic")
             ("fields" (jsown:new-js ("tenant_id" "secret")))
             ("doc" (jsown:new-js ("tenant_id" "secret")
               ("extensions" (jsown:new-js ("_server_outbox" (list (jsown:new-js ("payload" payload)))))))))))))
         (result (handle-public-search-route '(("q" . "name:needle"))))
         (row (first (jsown:val result "rows")))
         (doc (jsown:val row "doc")))
    (assert (not (jsown:keyp (jsown:val row "fields") "tenant_id")))
    (assert (not (jsown:keyp doc "tenant_id")))
    (assert (not (jsown:keyp (jsown:val (first (jsown:val (jsown:val doc "extensions") "_server_outbox")) "payload") "tenant_id"))))))
(check "backend failure is not silently an empty page" (lambda ()
  (let ((cl-couch::*failure* t))
    (assert (handler-case (progn (handle-public-search-route '(("q" . "name:needle"))) nil)
              (error () t))))))
(format t "~d hermetic Lisp checks; real extracted functions, dependency doubles.~%" *checks*)
