#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
TESTS=(
  "$ROOT/books/symbolic-ai-prolog/code/meta-interpreter/test_meta_interpreter.pl"
  "$ROOT/books/symbolic-ai-prolog/code/explicit-search/test_search.pl"
)

swipl --version
for test_file in "${TESTS[@]}"; do
  swipl -q -s "$test_file" -g "run_tests,halt(0)" -t "halt(1)"
done
