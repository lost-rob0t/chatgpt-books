digraph trajectory_seam {
  rankdir=LR; graph [label="BK10 / BK06 optional synthetic-continuous interface", labelloc=t, fontname="DejaVu Sans"];
  node [shape=box, fontname="DejaVu Sans", fontsize=10];
  "BK06 generated episode" -> "episode-ID split" [label="96, seed 148"];
