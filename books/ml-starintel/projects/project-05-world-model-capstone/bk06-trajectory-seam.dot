  "native fitted mixture" -> "16 sampled 6-step futures" [label="seed 248, no probability weights"];
  "24 held-out episodes" -> "6 sealed future events" [label="ticks 4..9, gold"];
  "16 sampled 6-step futures" -> "independent held-out scoring";
  "6 sealed future events" -> "independent held-out scoring";
